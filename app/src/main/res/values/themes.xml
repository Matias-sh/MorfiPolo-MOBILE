<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — Comedor Polo rework 2026 -->
    <style name="Base.Theme.Morfipolo" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorPrimaryVariant">@color/md_on_primary_container</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorSecondaryVariant">@color/md_on_secondary_container</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/md_surface_screen</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_container_high</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Typography & General -->
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">@color/md_ripple</item>
    </style>

    <style name="Theme.Morfipolo" parent="Base.Theme.Morfipolo" />

    <!-- ============ Shape scale ============ -->
    <style name="ShapeAppearance.Morfipolo.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_small</item>
    </style>
    <style name="ShapeAppearance.Morfipolo.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_medium</item>
    </style>
    <style name="ShapeAppearance.Morfipolo.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_large</item>
    </style>

    <!-- ============ Buttons ============ -->
    <style name="Widget.Morfipolo.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Morfipolo.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/md_surface_container_high</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <style name="Widget.Morfipolo.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/md_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/md_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Morfipolo.Button.TextDanger" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/md_error</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ============ Cards ============ -->
    <style name="Widget.Morfipolo.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/md_surface</item>
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/md_outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Morfipolo.Card.Medium">
        <item name="cardCornerRadius">@dimen/radius_medium</item>
    </style>

    <!-- ============ Type scale (Roboto) ============ -->
    <style name="TextAppearance.Morfipolo.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearance.Morfipolo.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearance.Morfipolo.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearance.Morfipolo.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>

    <style name="TextAppearance.Morfipolo.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/md_text_muted</item>
    </style>

    <!-- Alias legacy: Subhead usado por layouts existentes -->
    <style name="TextAppearance.Morfipolo.Subhead" parent="TextAppearance.Morfipolo.Label" />
</resources>

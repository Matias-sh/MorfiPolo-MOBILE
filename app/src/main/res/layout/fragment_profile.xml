<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface_screen"
    tools:context=".ui.profile.ProfileFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingBottom="100dp">

            <!-- Header compacto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    app:cardBackgroundColor="@color/md_primary"
                    app:cardCornerRadius="36dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/avatarTextView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/md_on_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="JP" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/nameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/md_on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Juan Pérez" />

                <TextView
                    android:id="@+id/dniTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/md_text_muted"
                    android:textSize="13sp"
                    tools:text="DNI 12.345.678" />
            </LinearLayout>

            <!-- Recordatorios -->
            <TextView
                style="@style/TextAppearance.Morfipolo.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/profile_section_reminders" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Morfipolo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:id="@+id/notificationSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_lg">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/chip_pending">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/notification_settings"
                            android:src="@android:drawable/ic_lock_idle_alarm"
                            app:tint="@color/chip_pending_text" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/notification_settings"
                            android:textColor="@color/md_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/reminders_enabled_hint"
                            android:textColor="@color/md_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/md_text_hint"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cuenta -->
            <TextView
                style="@style/TextAppearance.Morfipolo.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/profile_section_account" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Morfipolo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changePasswordButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/change_password"
                        android:textColor="@color/md_on_surface"
                        android:textSize="14sp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="@dimen/space_lg"
                        app:icon="@android:drawable/ic_menu_manage"
                        app:iconTint="@color/md_on_surface_variant"
                        app:iconPadding="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="@dimen/space_lg"
                        android:background="@color/md_divider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/logoutButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/logout"
                        android:textColor="@color/md_error"
                        android:textSize="14sp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="@dimen/space_lg"
                        app:icon="@android:drawable/ic_menu_close_clear_cancel"
                        app:iconTint="@color/md_error"
                        app:iconPadding="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/versionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="Comedor Polo"
                android:textColor="@color/md_text_hint"
                android:textSize="11sp" />

            <!-- Footer institucional -->
            <LinearLayout
                android:id="@+id/developmentFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:alpha="0.7"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Logo Dirección de Ingeniería"
                    android:src="@drawable/di_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:text="Desarrollado por la\nDirección de Ingeniería"
                    android:textColor="@color/md_text_muted"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:contentDescription="Sello del Gobierno"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sello_gobierno_02" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

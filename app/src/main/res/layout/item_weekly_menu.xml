<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    app:cardBackgroundColor="@color/md_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/chip_closed_bg"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/dayHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal"
            android:padding="@dimen/space_lg">

            <FrameLayout
                android:id="@+id/dayBadge"
                android:layout_width="@dimen/day_badge_size"
                android:layout_height="@dimen/day_badge_size"
                android:background="@drawable/chip_chosen">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dayNumTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chip_chosen_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="28" />

                    <TextView
                        android:id="@+id/dayShortTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:textAllCaps="true"
                        android:textColor="@color/chip_chosen_text"
                        android:textSize="9sp"
                        tools:text="Lun" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dayNameTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/md_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Lunes" />

                    <TextView
                        android:id="@+id/todayBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/chip_pending"
                        android:letterSpacing="0.03"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="HOY"
                        android:textColor="@color/chip_pending_text"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/menuDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/md_text_muted"
                    android:textSize="12sp"
                    tools:text="Milanesa napolitana con puré de papas" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_chosen"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="@color/chip_chosen_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Elegido" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expandedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@color/md_divider" />

            <TextView
                android:id="@+id/detailTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="13sp"
                tools:text="Elegiste: Milanesa napolitana con puré de papas" />

            <TextView
                android:id="@+id/changeSelectionAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="?attr/selectableItemBackground"
                android:minHeight="@dimen/touch_target_min"
                android:gravity="center_vertical"
                android:text="@string/change_choice"
                android:textColor="@color/md_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

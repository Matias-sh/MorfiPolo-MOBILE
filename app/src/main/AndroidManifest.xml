<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Alarmas exactas para recordatorios: SCHEDULE_EXACT_ALARM (el usuario la
         concede desde Ajustes en Android 12+). USE_EXACT_ALARM se quitó porque
         Play lo restringe a apps de alarma/reloj y podía causar rechazo. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- El fabricante (MIUI, ColorOS, EMUI, One UI, etc.) puede congelar el proceso
         en segundo plano y bloquear la entrega de la alarma aunque el permiso de
         alarma exacta esté concedido. Pedirle al usuario que excluya la app de la
         optimización de batería reduce (no elimina del todo, eso ya es específico
         de cada fabricante) ese riesgo. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".MorfipoloApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Morfipolo"
        tools:targetApi="31">
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <receiver
            android:name=".util.widget.MenuWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.cocido.morfipolo.SELECT_OPTION" />
                <action android:name="com.cocido.morfipolo.DELETE_VOTE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_menu_info" />
        </receiver>

        <service
            android:name=".util.widget.MenuWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Receiver para las notificaciones personalizadas del usuario -->
        <receiver
            android:name=".util.alarm.AlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.cocido.morfipolo.CUSTOM_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Receiver para reprogramar alarma después de reinicio del dispositivo -->
        <receiver
            android:name=".util.alarm.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<!-- Card de confirmación "Tu elección de hoy" (spec rework).
     Variante abierta: fondo primaryContainer verde, check primary.
     Variante cerrada: el fragment cambia fondo a surfaceContainerHigh y check a muted. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/selectionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_lg"
    app:cardBackgroundColor="@color/md_primary_container"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/checkBadge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/circle_check_badge">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/chosen"
                    android:src="@drawable/ic_check_bold"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/selectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:letterSpacing="0.03"
                android:text="@string/your_choice_today"
                android:textAllCaps="true"
                android:textColor="@color/md_on_primary_container"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/selectionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/md_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Milanesa napolitana con puré de papas" />

        <TextView
            android:id="@+id/selectionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/selection_change_until"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/removeSelectionAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="?attr/selectableItemBackground"
            android:minHeight="@dimen/touch_target_min"
            android:gravity="center_vertical"
            android:text="@string/remove_selection"
            android:textColor="@color/md_error"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
